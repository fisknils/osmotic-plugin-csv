{
	"name": "osmotic-plugin-csv",
	"version": "1.0.0",
	"description": "osmotic plugin that exports scraped rows to CSV files, streamed to disk and Excel-friendly by default",
	"keywords": [
		"osmotic-plugin",
		"osmotic",
		"csv",
		"export",
		"excel",
		"scraper"
	],
	"license": "ISC",
	"author": "",
	"type": "commonjs",
	"main": "dist/index.cjs",
	"types": "dist/index.d.cts",
	"files": [
		"dist",
		"examples",
		"README.md"
	],
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "npm run clean && tsc",
		"prepublishOnly": "npm run build",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"test": "npm run build && tsc -p test && node --test \"test/*.test.js\"",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"osmotic": "^3.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"osmotic": "file:../osmotic",
		"prettier": "3.3.3",
		"typescript": "^7.0.2"
	}
}
